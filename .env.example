# Provider Configuration: either 'anthropic' or 'openai'
PROVIDER=anthropic

# API Keys (you only need to provide a key for the provider you are using)
ANTHROPIC_API_KEY=your-api-key
OPENAI_API_KEY=your-api-key

# Primary Model Configuration: used for agentic interactions
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
OPENAI_MODEL=gpt-4o

# Fast Model Configuration: used for tasks that require fast response times
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
OPENAI_FAST_MODEL=gpt-4o-mini

# Provider Configuration
MAX_TOKENS=4096
TEMPERATURE=0.3
MAX_CONTEXT_TOKENS=100000

# Express Server Configuration (local development)
EXPRESS_SERVER_PORT=7777
EXPRESS_SERVER_HOST=localhost
EXPRESS_SERVER_CORS_ORIGIN=*
