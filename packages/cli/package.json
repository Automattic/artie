{
  "name": "@artie/cli",
  "version": "1.0.0",
  "description": "CLI interface for Artie",
  "main": "dist/index.js",
  "bin": {
    "artie": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "dev:watch": "tsx watch src/index.tsx",
    "build": "tsc --build --force && tsc-alias",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@artie/core": "workspace:*",
    "cli-markdown": "^3.4.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "ink": "^5.2.0",
    "ink-markdown": "^1.0.4",
    "ink-spinner": "^5.0.0",
    "react": "^18.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.55",
    "@types/uuid": "^10.0.0",
    "jsdom": "^26.1.0",
    "react-dom": "^18.2.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": true
  }
}
