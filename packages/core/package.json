{
  "name": "@artie/core",
  "version": "1.0.0",
  "description": "Core functionality for Artie",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build --force && tsc-alias",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/node": "^20.10.5",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^1.3.1",
    "rimraf": "^5.0.5",
    "ts-mockito": "^2.6.1",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": true
  }
}
